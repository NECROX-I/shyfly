PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/shyfly

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# Admin seed
ADMIN_NAME=Shyfly Admin
ADMIN_EMAIL=admin@shyfly.in
ADMIN_PASSWORD=ChangeMe@123

# Store rules (INR)
FREE_SHIPPING_MIN=999
SHIPPING_FEE=79
COD_FEE=40
COD_MAX_ORDER=15000
STORE_WHATSAPP=919000000000

# Razorpay (leave blank = COD only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (leave blank = paste image URLs in admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email via Resend (optional)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

# Sender shown on emails. Must be on a domain verified in Resend, e.g. Shyfly <orders@shyfly.in>
EMAIL_FROM=
