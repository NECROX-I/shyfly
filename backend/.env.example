PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/shyfly

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# Admin seed
ADMIN_NAME=Shyfly Admin
ADMIN_EMAIL=admin@shyfly.in
ADMIN_PASSWORD=ChangeMe@123

# Store rules (INR)
FREE_SHIPPING_MIN=999
SHIPPING_FEE=79
COD_FEE=40
COD_MAX_ORDER=15000
STORE_WHATSAPP=919000000000

# Razorpay (leave blank = COD only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (leave blank = paste image URLs in admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of this API — used in invoice links. Render sets RENDER_EXTERNAL_URL automatically;
# set this only if you use a custom API domain (e.g. https://api.yourdomain.in)
PUBLIC_API_URL=

# Email (invoice PDF is attached to the order email). Use ONE provider:
#  - Brevo: free tier, NO domain needed — verify a sender address (e.g. your Gmail) in Brevo, then set EMAIL_FROM to it
#  - Resend: free tier, but you must verify your own domain before it can email customers
BREVO_API_KEY=
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

# OPTIONAL automatic WhatsApp invoice (Meta WhatsApp Cloud API — Meta charges a small per-message fee).
# Without it, use the one-click "WhatsApp invoice" button on each order in the admin (free).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Sender shown on emails. Must be on a domain verified in Resend, e.g. Shyfly <orders@shyfly.in>
EMAIL_FROM=
