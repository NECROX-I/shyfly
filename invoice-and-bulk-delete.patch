diff --git a/backend/utils/notify.js b/backend/utils/notify.js
new file mode 100644
index 0000000..c061c13
--- /dev/null
+++ b/backend/utils/notify.js
@@ -0,0 +1,27 @@
+const { getSettings } = require('./settings');
+const { buildInvoicePdf } = require('./invoicePdf');
+const mail = require('./email');
+const wa = require('./whatsapp');
+
+const clientUrl = () => (process.env.CLIENT_URL || 'http://localhost:5173').split(',')[0].trim().replace(/\/$/, '');
+// public URL of this API (Render sets RENDER_EXTERNAL_URL automatically); `req` is used when available
+const apiUrl = (req) => (process.env.PUBLIC_API_URL || process.env.RENDER_EXTERNAL_URL || (req ? `${req.protocol}://${req.get('host')}` : '')).replace(/\/$/, '');
+
+exports.links = (order, req) => ({
+  pdf: `${apiUrl(req)}/api/orders/invoice.pdf?order=${order.orderNumber}&t=${order.invoiceToken}`,
+  page: `${clientUrl()}/invoice?order=${order.orderNumber}&t=${order.invoiceToken}`,
+  track: `${clientUrl()}/track?order=${order.orderNumber}`,
+});
+
+exports.pdfFor = async (order) => buildInvoicePdf(order, await getSettings());
+
+// order confirmed → email (with PDF attached) + optional automatic WhatsApp. Never throws.
+exports.orderPlaced = async (order, req) => {
+  try {
+    const l = exports.links(order, req);
+    let pdf = null;
+    try { pdf = await exports.pdfFor(order); } catch (e) { console.error('Invoice PDF error:', e.message); }
+    await mail.sendOrderPlaced(order, { pdf, link: l.pdf });
+    await wa.sendOrderWhatsApp(order, l.pdf);
+  } catch (e) { console.error('notify.orderPlaced:', e.message); }
+};
diff --git a/backend/utils/whatsapp.js b/backend/utils/whatsapp.js
new file mode 100644
index 0000000..3cda4bc
--- /dev/null
+++ b/backend/utils/whatsapp.js
@@ -0,0 +1,24 @@
+// Optional: automatic WhatsApp messages through Meta's WhatsApp Cloud API.
+// Needs: WHATSAPP_TOKEN, WHATSAPP_PHONE_ID and an APPROVED message template (WHATSAPP_TEMPLATE) with 4 body variables:
+//   {{1}} customer name  {{2}} order number  {{3}} total in rupees  {{4}} invoice link
+// Meta charges a small per-message fee for business-initiated messages — check current pricing before enabling.
+exports.waEnabled = () => !!(process.env.WHATSAPP_TOKEN && process.env.WHATSAPP_PHONE_ID && process.env.WHATSAPP_TEMPLATE);
+
+exports.sendOrderWhatsApp = async (order, link) => {
+  if (!exports.waEnabled()) return false;
+  try {
+    const res = await fetch(`https://graph.facebook.com/v20.0/${process.env.WHATSAPP_PHONE_ID}/messages`, {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${process.env.WHATSAPP_TOKEN}`, 'content-type': 'application/json' },
+      body: JSON.stringify({
+        messaging_product: 'whatsapp', to: `91${order.customer.phone}`, type: 'template',
+        template: { name: process.env.WHATSAPP_TEMPLATE, language: { code: process.env.WHATSAPP_TEMPLATE_LANG || 'en' }, components: [{ type: 'body', parameters: [order.customer.name, order.orderNumber, String(order.total), link].map((text) => ({ type: 'text', text: String(text) })) }] },
+      }),
+    });
+    if (!res.ok) throw new Error(`${res.status} ${(await res.text()).slice(0, 200)}`);
+    return true;
+  } catch (e) {
+    console.error('WhatsApp error:', e.message);
+    return false;
+  }
+};
